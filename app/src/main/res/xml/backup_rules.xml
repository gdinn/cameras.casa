<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and below. See data_extraction_rules.xml for API 31+.

   The DataStore files under filesDir/datastore/ are AES-encrypted with a key that lives in the
   Android Keystore and is bound to this device, so the key never travels with a backup. Restoring
   those files onto another device therefore yields ciphertext nobody can decrypt:
   EncryptedPreferencesSerializer catches the failure and returns defaultValue, so the user's
   cameras and WireGuard credentials appear to have vanished with no error at all. Excluding them
   makes the outcome honest — the app asks for the QR code again instead of coming up empty.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
