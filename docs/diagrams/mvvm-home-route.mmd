---
title: "MVVM - Home route (NavigationRoute.Home)"
---
flowchart LR
  classDef view fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  classDef vm fill:#fff3e0,stroke:#ef6c00,color:#e65100
  classDef model fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  classDef data fill:#eceff1,stroke:#455a64,color:#263238
  classDef logic fill:#fce4ec,stroke:#ad1457,color:#880e4f

  subgraph V["VIEW - Composables"]
    direction TB
    Nav["NavigationRoot"]
    Route["HomeRoute<br/>feature/cameras/HomeRoute.kt"]
    Loading["LoadingScreen"]
    Empty["EmptyStreamsScreen"]
    Screen["HomeScreen<br/>DynamicStreamGrid | FixedStreamGrid | FocusedStreamView<br/>+ history button (Samba login)"]
    Player["WebRtcVideoPlayer<br/>SurfaceViewRenderer (VideoSink)"]
    Dialog["InterruptedDownloadsDialog<br/>(Samba login, over a ready Home)"]
    Nav --> Route
    Route --> Loading
    Route --> Empty
    Route --> Screen
    Route --> Dialog
    Screen --> Player
  end

  subgraph VMG["VIEWMODEL"]
    direction TB
    VM["HomeViewModel : ToastEventViewModel"]
    Inputs["_orientation, _focusedStream, _resumed<br/>MutableStateFlow, UI-driven inputs"]
    State["HomeUiState = Loading | Empty | Ready(..., historyCamera)<br/>combine(prefs, orientation, focus + hasRecordingsAccess, failed, vpnState)"]
    Offer["interruptedDownloads: StateFlow<br/>(Samba login only)"]
    Inputs --> State
    VM --> Inputs
    VM --> State
    VM --> Offer
  end

  subgraph L["FEATURE LOGIC - pure, View-side"]
    Paging["StreamPaging.kt: itemsPerPage, pageCount,<br/>streamsOnPage, reorderedTo, movedToPage"]
    Layout["FixedGridLayout.kt: fixedGridRowHeights,<br/>fittedCellSize"]
  end

  subgraph M["MODEL - domain"]
    direction TB
    UCprefs["GetStreamPreferencesUseCase"]
    UCorder["UpdateStreamOrderUseCase"]
    UCvpnState["ObserveVpnStateUseCase"]
    UCadmin["ObserveHasRecordingsAccessUseCase"]
    UCdl["Observe/Resume/DiscardDownloadsUseCase"]
    Coord["TunnelCoordinator<br/>request / release HOME holder"]
    StreamRepo["StreamConnectionRepository<br/>core/webrtc/ (contract)"]
  end

  subgraph D["DATA / EXTERNAL"]
    direction TB
    Store["DataStore: stream-preferences"]
    VpnRepo["VpnRepository -> WireGuard GoBackend"]
    Downloads["DownloadRepository -> WorkManager<br/>+ DataStore: download-records"]
    Whep["WhepConnectionManager -> WhepClient<br/>POST offer to streamUrl/whep"]
  end

  Route -->|"EVENTS IN: onOrientationChanged, onResumed/onPaused,<br/>onBackPressed, onResume/DiscardDownloads"| VM
  Screen -->|"EVENTS IN: focusStream(url), clearFocusedStream(),<br/>onStreamsReordered(newOrder)"| VM
  Player -->|"EVENTS IN: connectStream(url, videoSink),<br/>disconnectStream(url)"| VM

  State -->|"STATE OUT: uiState StateFlow of HomeUiState<br/>collectAsStateWithLifecycle"| Route
  VM -->|"EVENT OUT: navigateUiEvent<br/>ToConfig | ExitApp (Channel)"| Route
  VM -->|"uiEvent: ToastUiEvent"| Route
  Offer -->|"STATE OUT: interruptedDownloads"| Route
  Route -->|"onNavigateToConfig() / onNavigateToHistory(camera)<br/>/ activity.finish()"| Nav

  Screen --> Paging
  Screen --> Layout

  VM --> UCprefs
  VM --> UCorder
  VM --> UCvpnState
  VM --> UCadmin
  VM --> UCdl
  VM -->|"request / release, connectFailures"| Coord
  VM -->|"connect / disconnect / closeAll"| StreamRepo

  UCprefs --> Store
  UCorder --> Store
  UCvpnState --> VpnRepo
  Coord -->|"one collector: connect / disconnect"| VpnRepo
  UCdl --> Downloads
  StreamRepo --> Whep

  class Nav,Route,Loading,Empty,Screen,Player,Dialog view
  class VM,Inputs,State,Offer vm
  class UCprefs,UCorder,UCvpnState,UCadmin,UCdl,Coord,StreamRepo model
  class Paging,Layout logic
  class Store,VpnRepo,Whep,Downloads data
