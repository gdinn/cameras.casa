    UCcam["HasCameraPermissionUseCase"]
    UCvpnp["HasVpnPermissionUseCase"]
    UCreq["RequestVpnPermissionUseCase"]
  end

  subgraph D["DATA"]
    direction TB
    Store1["DataStore: user-preferences"]
    Store2["DataStore: stream-preferences"]
    Perm["Android: VpnService.prepare()<br/>ContextCompat.checkSelfPermission()"]
  end

  Route -->|"EVENTS IN: onShowScanner, acceptVpnPermission,<br/>onRequestCameraPermission, onQrCodeScanned(rawJson),<br/>onNavigateToHomeRequested, onBackPressedBlocked,<br/>refreshCameraPermissionState, setCanNavigateBackToHome"| VM
