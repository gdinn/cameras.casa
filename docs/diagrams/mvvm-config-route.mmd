    VM["ConfigViewModel : ToastEventViewModel"]
    State["ConfigUiState<br/>4 x ConfigButtonState + canNavigateBackToHome<br/>derived: missingRequirement, canNavigateToHome"]
    VM -->|"combine(5 flows).stateIn(Eagerly)"| State
  end

  subgraph M["MODEL - domain"]
    direction TB
    UCqr["ParseUserPreferencesFromQrCodeUseCase"]
    UCsave["SaveUserPreferencesUseCase"]
