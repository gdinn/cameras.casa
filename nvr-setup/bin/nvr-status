#!/usr/bin/env bash
# ============================================================
# nvr-status — Shows the overall NVR status
# ============================================================
set -euo pipefail

CONF_FILE="/etc/nvr/nvr.conf"
[[ -f "$CONF_FILE" ]] && source "$CONF_FILE"

STORAGE_DIR="${STORAGE_DIR:-/mnt/backup_cams}"
CAMERAS="${CAMERAS:-cam_10}"
RETENTION_DAYS="${RETENTION_DAYS:-30}"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║          📹  Mini NVR — Status               ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
echo ""

# --- Disk ------------------------------------------------------------
# Without the USB disk, df would report the SD card instead.
if ! mountpoint -q "$STORAGE_DIR"; then
    echo -e "${RED}${BOLD}$STORAGE_DIR is not mounted: nothing is being recorded.${NC}"
    echo ""
    exit 1
fi

disk_total=$(df -h "$STORAGE_DIR" --output=size | tail -1 | tr -d ' ')
disk_used=$(df -h "$STORAGE_DIR" --output=used | tail -1 | tr -d ' ')
disk_free=$(df -h "$STORAGE_DIR" --output=avail | tail -1 | tr -d ' ')
disk_pct=$(df "$STORAGE_DIR" --output=pcent | tail -1 | tr -d ' %')

if (( disk_pct > 90 )); then
    disk_color="$RED"
elif (( disk_pct > 75 )); then
    disk_color="$YELLOW"
else
    disk_color="$GREEN"
fi

echo -e "${BOLD}Disk:${NC}"
echo -e "  Total: $disk_total  |  Used: $disk_used  |  Free: ${disk_color}${disk_free}${NC} (${disk_color}${disk_pct}%${NC} used)"
echo -e "  Retention: ${RETENTION_DAYS} days"
echo ""

# --- NVR total -------------------------------------------------------
nvr_size=$(du -sh "$STORAGE_DIR" 2>/dev/null | cut -f1)
nvr_files=$(find "$STORAGE_DIR" -name "*.mp4" -type f 2>/dev/null | wc -l)
echo -e "${BOLD}Recordings:${NC}  ${nvr_size} total  |  ${nvr_files} files"
echo ""

# --- Cameras ---------------------------------------------------------
echo -e "${BOLD}Cameras:${NC}"
echo -e "  %-10s %-12s %-8s %-10s %-8s %s" "ID" "NAME" "STATUS" "SIZE" "FILES" "LATEST"
echo "  ─────────────────────────────────────────────────────────────────"

for cam in $CAMERAS; do
    name_var="${cam^^}_NAME"
    cam_name="${!name_var:-$cam}"

    # Service status
    if systemctl is-active --quiet "nvr@${cam}" 2>/dev/null; then
        status="${GREEN}● active${NC}"
    else
        status="${RED}● stopped${NC}"
    fi

    # Size
    cam_dir="$STORAGE_DIR/$cam"
    if [[ -d "$cam_dir" ]]; then
        cam_size=$(du -sh "$cam_dir" 2>/dev/null | cut -f1)
        cam_files=$(find "$cam_dir" -name "*.mp4" -type f 2>/dev/null | wc -l)

        # Latest file
        last_file=$(find "$cam_dir" -name "*.mp4" -type f -printf '%T+ %f\n' 2>/dev/null \
            | sort -r | head -1 | awk '{print $2}')
        if [[ -n "$last_file" ]]; then
            # Time from the name: cam_10_2026-02-13_14-30-00.mp4
            last_time=$(echo "$last_file" | grep -oP '\d{2}-\d{2}-\d{2}(?=\.mp4)' | tr '-' ':')
            last_date=$(echo "$last_file" | grep -oP '\d{4}-\d{2}-\d{2}')
            last_info="$last_date $last_time"
        else
            last_info="-"
        fi
    else
        cam_size="-"
        cam_files="0"
        last_info="-"
    fi

    printf "  %-10s %-12s " "$cam" "$cam_name"
    echo -ne "$status"
    printf "   %-10s %-8s %s\n" "$cam_size" "$cam_files" "$last_info"
done

echo ""

# --- Today's recordings ----------------------------------------------
today=$(date '+%Y-%m-%d')
echo -e "${BOLD}Today (${today}):${NC}"
for cam in $CAMERAS; do
    day_dir="$STORAGE_DIR/$cam/${today:0:4}/${today:5:2}/${today:8:2}"
    if [[ -d "$day_dir" ]]; then
        today_files=$(find "$day_dir" -name "*.mp4" -type f | wc -l)
        today_size=$(du -sh "$day_dir" 2>/dev/null | cut -f1)
        echo "  $cam: $today_files files ($today_size)"
    else
        echo "  $cam: no recordings"
    fi
done
echo ""
